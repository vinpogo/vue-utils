{
  "name": "@vingy/vue-utilities",
  "description": "Monorepo for all my vue utilities.",
  "license": "MIT",
  "author": "vingy",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinpogo/vue-utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "nimver install-hooks --force || exit 0",
    "test": "pnpm vitest",
    "build": "pnpm -r --sort build",
    "dev": "pnpm -r --parallel --stream dev",
    "demo": "pnpm --filter demo run dev",
    "typecheck": "tsc --noEmit && pnpm --filter demo run typecheck",
    "bump": "nimver bump",
    "publish": "pnpm build && pnpm -r publish --no-git-checks"
  },
  "devDependencies": {
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "@vingy/nimver": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
